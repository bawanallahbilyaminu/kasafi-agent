{
  "permissions": {
    "allow": [
      "Bash(git init:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(git remote:*)",
      "Bash(git tag:*)",
      "Bash(gh repo create:*)",
      "Bash(gh repo view:*)",
      "Bash(gh auth status:*)",
      "Bash(ssh vps docker logs:*)",
      "Bash(ssh vps docker ps:*)",
      "Bash(ssh vps docker compose -f /opt/kasafi-agent/deploy/docker-compose.yml ps:*)",
      "Bash(ssh vps curl -s http://127.0.0.1:8010/health:*)",
      "Bash(deploy/deploy.sh)",
      "Bash(deploy/deploy.sh --rollback)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.production)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)"
    ]
  }
}
