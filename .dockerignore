# Never bake secrets or data into the image.
.env
.env.*
data/
# ... except the source registry (public; the fetch allowlist and topics come from it). data/private/ stays out.
!data/source_registry.yaml
!data/catalog.yaml
!data/emergency_contacts.yaml
!data/manifest.json
!data/official_outlooks.yaml
.git/
.venv/
__pycache__/
*.pyc
.pytest_cache/
.claude/
evals/
tests/
docs/
scripts/
# ... except the topic prefetch, run on the server (docker compose exec api python scripts/prefetch_topics.py)
!scripts/prefetch_topics.py
!scripts/import_geo.py
!scripts/match_emonc.py
# ... and the local documents' indexing (deploy.sh --sync-advisories) and a manual hazard fetch
!scripts/index_docs.py
!scripts/ocr_pages.py
!scripts/official_outlooks.py
!scripts/fetch_hazards.py
*.log
