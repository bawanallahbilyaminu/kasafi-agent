# Copy to .env and fill in. NEVER commit .env.

# Meta Model API (dev.meta.ai)
META_API_KEY=

# Baseten (Muse Spark Open: meta-models/muse-spark-open-1026)
BASETEN_API_KEY=

# Web search (serper.dev)
SERPER_API_KEY=

# WhatsApp Cloud API (Meta app → WhatsApp → API Setup)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# Pilot numbers allowed to use voice (comma-separated, e.g. 2348000000000). Never commit real numbers.
KASAFI_PILOT_NUMBERS=
# WhatsApp Business Account ID (WhatsApp → API Setup); not a secret, but kept out of the repo
WHATSAPP_BUSINESS_ACCOUNT_ID=

# Modal (optional until credits confirmed)
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# Fireworks (optional)
FIREWORKS_API_KEY=

# Database (dev: docker compose Postgres; deploy: Azure Flexible Server with sslmode=require)
DATABASE_URL=
# Password for the local docker-compose Postgres (dev only)
POSTGRES_PASSWORD=

# Admin page basic auth (use a long random password)
ADMIN_USER=
ADMIN_PASSWORD=
