# Copy to .env and fill in. NEVER commit .env.

# Meta Model API (dev.meta.ai)
META_API_KEY=

# Baseten (Muse Spark Open: meta-models/muse-spark-open-1026)
BASETEN_API_KEY=
# The second of the two row readings runs on Muse Spark Open; Muse Spark reads instead after this many seconds
#KASAFI_OPEN_READER=true
#KASAFI_OPEN_READ_TIMEOUT_S=20
# Other stages on Muse Spark Open too (comma list: plan, compose); Muse Spark answers after this many seconds
#KASAFI_OPEN_STAGES=
#KASAFI_OPEN_STAGE_TIMEOUT_S=15

# Fireworks AI (Muse Spark Open: accounts/fireworks/models/muse-spark-open), the fallback host when Baseten fails
FIREWORKS_API_KEY=

# Hazard information (docs/hazard-and-services.md); both optional, Kasafi works without them:
# OpenRouteService directions (road distance and time to a facility; without it, straight-line distance)
ORS_API_KEY=
# NASA FIRMS active fire detections (the fires layer; without it, that layer is off)
FIRMS_MAP_KEY=
# Run the hazard fetchers on their schedule inside the app (forecast/fires 3 h, air 6 h, rivers daily)
#KASAFI_HAZARD_FETCH=false
#KASAFI_ADVISORIES_FETCH=false
#KASAFI_ADVISORIES_MONTHLY_USD=2.0
# Hazard alerts people sign up for (app/alerts): checked after each fetch round when on; the dry run (default)
# shows them on /admin/alerts and sends nothing. The daily cap is template messages a day, all users (0 = none live)
#KASAFI_ALERTS=false
#KASAFI_ALERTS_DRY_RUN=true
#KASAFI_ALERTS_DAILY_CAP=0
#KASAFI_ALERT_TEMPLATE_LANGS=ha
# Fernet key that encrypts the WhatsApp number of alert subscribers only (app/alerts/recipients.py). Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
KASAFI_ALERTS_NUMBER_KEY=

# Eval runs stop when the day's eval spend reaches this many US dollars (evals/runtime.py)
#EVAL_DAILY_USD=5

# Web search (serper.dev)
SERPER_API_KEY=
# ReliefWeb API v2: pre-approved appname (request at apidoc.reliefweb.int); its search is skipped while empty
RELIEFWEB_APPNAME=
# IOM DTM API (free keys from dtm-apim-portal.iom.int, Profile -> Primary key); each is skipped while empty
# "Baseline API": displacement figures by country, state and LGA (v3)
DTMAPI_SUBSCRIPTION_KEY=
# "Humanitarian Needs Assessment (HNA) API": LGA level only (v1)
DTMHNA_SUBSCRIPTION_KEY=

# WhatsApp Cloud API (Meta app → WhatsApp → API Setup)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# Access: open to everyone after consent (default true). If false, only KASAFI_PILOT_NUMBERS are served.
KASAFI_OPEN_ACCESS=true
# Pilot numbers (comma-separated, e.g. 2348000000000), used only when KASAFI_OPEN_ACCESS=false. Never commit real numbers.
KASAFI_PILOT_NUMBERS=
# Secret key for hashing phone numbers into user IDs (long random value, e.g. openssl rand -hex 32). Keep it
# stable: changing it resets every user's consent and language.
KASAFI_HASH_KEY=
# Security-agency budget figures (e.g. Community Guard Corps, security votes): true answers them as plain cited
# figures with no commentary; operational, conflict and incident questions are declined either way (CLAUDE.md rule 5).
KASAFI_ALLOW_SECURITY_BUDGET=true
# Our own test numbers (comma-separated): exempt from the daily limits and the spend cap. Never commit real numbers.
KASAFI_EXEMPT_NUMBERS=
# Daily limits and spend cap (the per-call costs are estimates; calibrate against Meta billing)
KASAFI_VOICE_PER_DAY=20
KASAFI_QUESTIONS_PER_DAY=50
KASAFI_DAILY_SPEND_CAP_USD=5
KASAFI_COST_PER_VOICE_USD=0.02
KASAFI_COST_PER_QUESTION_USD=0.01
# WhatsApp Business Account ID (WhatsApp → API Setup); not a secret, but kept out of the repo
WHATSAPP_BUSINESS_ACCOUNT_ID=

# Modal (optional until credits confirmed)
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# Fireworks (optional)
FIREWORKS_API_KEY=

# Database (dev: docker compose Postgres; deploy: Azure Flexible Server with sslmode=require)
DATABASE_URL=
# Password for the local docker-compose Postgres (dev only)
POSTGRES_PASSWORD=

# Admin page basic auth (use a long random password)
ADMIN_USER=
ADMIN_PASSWORD=
